{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "crons": [
    { "path": "/api/cron/followups", "schedule": "0 12 * * *" },
    { "path": "/api/cron/doc-expiry", "schedule": "0 13 * * *" },
    { "path": "/api/cron/backup-check", "schedule": "0 14 * * 0" },
